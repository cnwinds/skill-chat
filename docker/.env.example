NODE_ENV=production
PORT=3000
WEB_PORT=7070
WEB_ORIGIN=http://localhost:7070
DATA_ROOT=/app/data
SKILLS_ROOT=/app/skills
# Skill market bootstrap default; admin can override at runtime in Settings → System.
# MARKET_BASE_URL=http://localhost:3100
SESSION_EXPIRES_IN=7d
# Docker build: npmmirror for most deps; @skillchat/* always resolves from registry.npmjs.org (see Dockerfile).
# Override only if you want all packages from npmjs: NPM_REGISTRY=https://registry.npmjs.org
# NPM_REGISTRY=https://registry.npmmirror.com
HARNESSKIT_VERSION=0.1.1
# WEB_ORIGIN must match the final external browser origin, for example https://app.example.com.
# OpenAI / Assistant Tools runtime config stays in system settings.
ENABLE_REASONING_EVENTS=false
LLM_REQUEST_TIMEOUT_MS=45000
MAX_CONCURRENT_RUNS=5
RUN_TIMEOUT_MS=120000
