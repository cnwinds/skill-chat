NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATA_ROOT=./data
SKILLS_ROOT=./skills
# Skill market bootstrap default; admin can override at runtime in Settings → System.
# MARKET_BASE_URL=http://localhost:3100
SESSION_EXPIRES_IN=7d
# WEB_ORIGIN must exactly match the browser-facing frontend origin.
# OpenAI / Assistant Tools runtime config stays in system settings (Settings → System).
# Env below are bootstrap defaults; admin UI can override at runtime.
ENABLE_REASONING_EVENTS=false
# Web search: live | cached | disabled
# WEB_SEARCH_MODE=live
# WEB_SEARCH_PROVIDERS=openai_native,tavily,serper,brave
# OPENAI_NATIVE_WEB_SEARCH=auto
# TAVILY_API_KEY=
# SERPER_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Image generation Native policy: auto | on | off
# OPENAI_NATIVE_IMAGE_GENERATION=auto
# IMAGE_PROVIDERS=openai_images,zhipu,bailian
# OPENAI_IMAGE_API_KEY=
# OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-2
# ZHIPU_IMAGE_API_KEY=
# DASHSCOPE_IMAGE_API_KEY=
IMAGE_THUMBNAIL_THRESHOLD_BYTES=262144
IMAGE_THUMBNAIL_MAX_WIDTH=640
IMAGE_THUMBNAIL_MAX_HEIGHT=640
IMAGE_THUMBNAIL_QUALITY=78
LLM_REQUEST_TIMEOUT_MS=45000
MAX_CONCURRENT_RUNS=5
RUN_TIMEOUT_MS=120000
